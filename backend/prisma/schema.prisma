generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  passwordHash     String
  resetToken       String?
  resetTokenExpiry DateTime?
  trips            Trip[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Trip {
  id                  String     @id @default(uuid())
  title               String
  description         String?
  coverPhoto          String?

  destinationCity     String
  destinationCountry  String?

  startDate           DateTime
  endDate             DateTime

  plannedBudget       Decimal    @default(0) @db.Decimal(10, 2)
  spentBudget         Decimal    @default(0) @db.Decimal(10, 2)

  status              TripStatus @default(PLANNED)

  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  stops              TripStop[]

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([userId])
  @@index([startDate])
  @@index([status])
}

model TripStop {
  id          String   @id @default(cuid())
  tripId      String

  city        String
  country     String   @default("India")
  startDate   DateTime
  endDate     DateTime

  stopOrder   Int      @default(0)
  notes       String?

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tripId])
  @@index([tripId, stopOrder])
}

model Destination {
  id            String   @id @default(cuid())
  city          String
  country       String   @default("India")
  description   String?
  averageBudget Decimal  @default(0) @db.Decimal(10, 2)
  imageUrl      String?
  isPopular     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([city, country])
  @@index([isPopular])
}

enum TripStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}
